# Copy to .env and fill in. Never commit real values.
APP_ENV=development
POSTGRES_DB=kisanshield
POSTGRES_USER=kisanshield
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://kisanshield:change-me@postgres:5432/kisanshield
JWT_SECRET=change-me
MODEL_SIGNING_KEY_PATH=/run/secrets/model_signing_key.pem
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_BUCKET=kisanshield-models
OBJECT_STORAGE_ACCESS_KEY=change-me
OBJECT_STORAGE_SECRET_KEY=change-me
FL_MIN_CLIENTS_PER_ROUND=10
